<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
    <RootNamespace>HoloWin.App</RootNamespace>
    <AssemblyName>HoloWin</AssemblyName>
    <UseWindowsForms>false</UseWindowsForms>
    <UseWPF>false</UseWPF>
    <UseWinUI>true</UseWinUI>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <PlatformTarget Condition="'$(RuntimeIdentifier)' == 'win-x64'">x64</PlatformTarget>
    <PlatformTarget Condition="'$(RuntimeIdentifier)' == 'win-arm64'">ARM64</PlatformTarget>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKDeploymentManagerInitialize>false</WindowsAppSDKDeploymentManagerInitialize>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxPackageSigningPassword></AppxPackageSigningPassword>
    <GenerateTemporaryStoreCertificate>false</GenerateTemporaryStoreCertificate>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <SelfContained>false</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\HoloWin.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="..\..\assets\HoloWin.ico" Link="Assets\HoloWin.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\assets\*.png" Link="Assets\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\models\*.onnx;..\..\models\*.txt" Link="models\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\HoloWin.Core\HoloWin.Core.csproj" />
    <ProjectReference Include="..\HoloWin.Audio\HoloWin.Audio.csproj" />
    <ProjectReference Include="..\HoloWin.Vision\HoloWin.Vision.csproj" />
    <ProjectReference Include="..\HoloWin.Sensors\HoloWin.Sensors.csproj" />
    <ProjectReference Include="..\HoloWin.SensorFusion\HoloWin.SensorFusion.csproj" />
    <ProjectReference Include="..\HoloWin.Gestures\HoloWin.Gestures.csproj" />
    <ProjectReference Include="..\HoloWin.Calibration\HoloWin.Calibration.csproj" />
    <ProjectReference Include="..\HoloWin.Actions\HoloWin.Actions.csproj" />
    <ProjectReference Include="..\HoloWin.Automation\HoloWin.Automation.csproj" />
    <ProjectReference Include="..\HoloWin.Persistence\HoloWin.Persistence.csproj" />
    <ProjectReference Include="..\HoloWin.Plugins\HoloWin.Plugins.csproj" />
    <ProjectReference Include="..\HoloWin.Diagnostics\HoloWin.Diagnostics.csproj" />
    <ProjectReference Include="..\HoloWin.Platform.Windows\HoloWin.Platform.Windows.csproj" />
  </ItemGroup>
</Project>
